{
  "name": "opencode-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Marketplace for OpenCode Desktop: browse and install plugins, MCP servers and skills.",
  "exports": {
    ".": "./dist/index.js",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && esbuild src/index.ts --bundle --platform=node --format=esm --external:@opencode/plugin --external:jsonc-parser --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.0",
    "@types/node": "^22.10.0",
    "effect": "4.1.0",
    "esbuild": "^0.28.0",
    "solid-js": "^1.9.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^7.1.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
